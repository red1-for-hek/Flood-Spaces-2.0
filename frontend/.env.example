# Backend API base URL (Render / Railway / any host). Leave empty to use same-origin.
VITE_API_BASE_URL=http://localhost:8004

# Telegram bot username shown in the "Open bot" button (without @).
VITE_TELEGRAM_BOT_USERNAME=

# Optional: custom raster tile template(s), comma separated. No key required by default.
# Example: https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILES=
