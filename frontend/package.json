{
  "name": "flood-spaces-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild smoke/render.smoke.tsx --bundle --platform=node --format=cjs --target=node20 --outfile=node_modules/.cache/smoke.cjs --external:jsdom --alias:maplibre-gl=./smoke/maplibre-stub.ts --loader:.css=empty --log-level=error --define:import.meta.env='{\"DEV\":true,\"PROD\":false,\"MODE\":\"development\",\"VITE_API_BASE_URL\":\"\",\"VITE_TELEGRAM_BOT_USERNAME\":\"\",\"VITE_MAP_TILES\":\"\"}' && node node_modules/.cache/smoke.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
