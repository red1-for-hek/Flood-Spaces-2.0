# Groq AI Configuration (Primary AI Engine)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Telegram Auto-Alert Bot Configuration
# Anyone who sends /start to your bot is automatically subscribed to flood alerts!
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
ALERT_DEFAULT_THRESHOLD=50
ALERT_RADIUS_KM=100
ALERT_COOLDOWN_MINUTES=60

# Optional Weather & Satellite Keys
OPENWEATHER_API_KEY=
NASA_API_KEY=

# Allowed Frontend Origins (comma-separated, e.g. https://floodspaces.vercel.app,http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
